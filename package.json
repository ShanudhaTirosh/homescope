{
  "name": "homescope-network-monitor",
  "version": "0.2.1",
  "productName": "HomeScope",
  "description": "A private, always-on macOS menu-bar monitor for a home network.",
  "author": "Azif",
  "private": true,
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "collector": "node --disable-warning=ExperimentalWarning collector/server.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "HOMESCOPE_VERCEL_BUILD=1 next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:dev": "npm run build && electron .",
    "desktop:app": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64",
    "desktop:dmg": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "auth:password": "node scripts/hash-password.mjs",
    "cloud:secrets": "node scripts/create-cloud-secrets.mjs",
    "cloud:setup": "node scripts/cloud-secrets-server.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "lk.homescope.networkmonitor",
    "productName": "HomeScope",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-assets/HomeScopeTemplate.png",
        "to": "HomeScopeTemplate.png"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "desktop-assets/HomeScope.icns",
      "extendInfo": {
        "LSUIElement": false,
        "NSLocalNetworkUsageDescription": "HomeScope needs access to your local network to discover your routers, access points, and connected devices."
      },
      "target": [
        "dir",
        "dmg"
      ]
    }
  }
}
