[Unit]
Description=HomeScope private network collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homescope
Group=homescope
WorkingDirectory=/opt/homescope
EnvironmentFile=/etc/homescope/collector.env
Environment=NODE_ENV=production
Environment=HOMESCOPE_DATA_DIR=/var/lib/homescope
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/homescope/collector/server.mjs
Restart=always
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/homescope

[Install]
WantedBy=multi-user.target
