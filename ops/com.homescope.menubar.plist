<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.homescope.menubar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/Applications/HomeScope.app/Contents/MacOS/HomeScope</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/tmp/homescope-menubar.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/homescope-menubar.err</string>
</dict>
</plist>
