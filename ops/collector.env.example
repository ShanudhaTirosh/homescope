# The collector stays behind Caddy on the VPS loopback interface.
COLLECTOR_HOST=127.0.0.1
COLLECTOR_PORT=4318
COLLECTOR_API_TOKEN=replace-with-a-long-random-token
SCAN_INTERVAL_SECONDS=60
ASSOCIATION_INTERVAL_SECONDS=5
SLT_ASSOCIATION_INTERVAL_SECONDS=30
SCAN_ENABLED=false
NETWORK_SUBNET=192.168.1

# These private LAN addresses become reachable after the ZLT-to-VPS VPN is active.
SLT_URL=http://192.168.1.1
SLT_USER=
SLT_PASS=
ZLT_URL=https://192.168.1.2
ZLT_USER=
ZLT_PASS=
DLINK_URL=http://192.168.1.3
DLINK_USER=
DLINK_PASS=
TPLINK_URL=http://192.168.1.4
TPLINK_USER=
TPLINK_PASS=

# Optional visibility services.
NEXTDNS_PROFILE_ID=
NEXTDNS_API_KEY=
PIHOLE_URL=
PIHOLE_TOKEN=
ADGUARD_URL=
ADGUARD_USER=
ADGUARD_PASS=
NTOPNG_URL=
NTOPNG_USER=
NTOPNG_PASS=
