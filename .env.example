# HomeScope stays on this Mac. Copy this file to .env.local if you add sensors.
NEXT_PUBLIC_HOMESCOPE_DISPLAY_NAME=
NETWORK_SUBNET=192.168.1
COLLECTOR_PORT=4318
COLLECTOR_HOST=127.0.0.1
SCAN_INTERVAL_SECONDS=60
# Direct router/AP client tables refresh separately from the full LAN scan.
ASSOCIATION_INTERVAL_SECONDS=5
# The SLT firmware is slower and can stop answering if its web UI is hammered.
SLT_ASSOCIATION_INTERVAL_SECONDS=30

# Required only for a remotely hosted collector.
COLLECTOR_API_TOKEN=

# Vercel dashboard authentication and protected collector proxy.
HOMESCOPE_AUTH_REQUIRED=false
HOMESCOPE_LOGIN_EMAIL=
HOMESCOPE_PASSWORD_SCRYPT=
HOMESCOPE_SESSION_SECRET=
HOMESCOPE_COLLECTOR_URL=http://127.0.0.1:4318
HOMESCOPE_COLLECTOR_TOKEN=

# Main SLT router client table (kept local; never sent to the browser)
SLT_URL=http://192.168.1.1
SLT_USER=
SLT_PASS=

# Optional built-in access-point client-table adapters
ZLT_URL=https://192.168.1.2
ZLT_USER=
ZLT_PASS=
DLINK_URL=http://192.168.1.3
DLINK_USER=
DLINK_PASS=
TPLINK_URL=http://192.168.1.4
TPLINK_USER=
TPLINK_PASS=

# Optional cloud DNS history (can also be saved from HomeScope Settings)
NEXTDNS_PROFILE_ID=
NEXTDNS_API_KEY=

# Optional domain-history sensor (choose one)
PIHOLE_URL=
PIHOLE_TOKEN=
ADGUARD_URL=
ADGUARD_USER=
ADGUARD_PASS=

# Optional per-device traffic and application sensor
NTOPNG_URL=
NTOPNG_USER=
NTOPNG_PASS=
